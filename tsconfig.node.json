{
  "extends": ["@tsconfig/node24/tsconfig.json", "./tsconfig.strict.json"],
  "include": [
    "vite.config.*",
    "vitest.config.*",
    "cypress.config.*",
    "eslint.config.*",
    "eslint/**/*.ts",
    "lint-staged.config.*",
    "scripts/**/*.ts",
    "commitlint.config.*"
  ],
  "compilerOptions": {
    "module": "preserve",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "noEmit": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo"
  }
}
