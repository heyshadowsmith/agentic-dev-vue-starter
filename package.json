{
  "name": "agentic-dev-vue-starter",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test:unit": "vitest",
    "test:coverage": "vitest run --coverage",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "run-s \"lint:*\"",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "format": "prettier --write --experimental-cli src/",
    "check:format": "prettier --check --experimental-cli src/",
    "check:markdown": "markdownlint-cli2",
    "check:lint": "oxlint . && eslint .",
    "check:secrets": "secretlint \"**/*\"",
    "check:architecture": "archlint scan --no-cache",
    "check:dead-code": "knip --treat-config-hints-as-errors",
    "prepare": "husky"
  },
  "dependencies": {
    "@ui-sdk/core": "0.1.0-beta.6",
    "@ui-sdk/vue": "0.1.0-beta.6",
    "pinia": "^4.0.3",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@archlinter/cli": "0.17.1",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@commitlint/types": "^21.2.3",
    "@eslint/css": "^2.0.1",
    "@eslint/json": "^2.1.1",
    "@html-eslint/parser": "^0.68.0",
    "@tailwindcss/vite": "^4.3.5",
    "@tsconfig/node24": "^24.0.5",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.13.4",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "4.1.12",
    "@vitest/eslint-plugin": "^1.6.27",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-functional": "^10.0.1",
    "eslint-plugin-oxlint": "~1.82.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-unicorn": "^80.0.0",
    "eslint-plugin-vue": "~10.11.0",
    "husky": "9.1.7",
    "jiti": "^2.7.0",
    "jsdom": "^30.0.1",
    "knip": "^6.45.1",
    "markdownlint-cli2": "^0.24.1",
    "npm-run-all2": "^9.0.3",
    "oxlint": "~1.82.0",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "secretlint": "^14.0.1",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.0",
    "vite": "^8.2.2",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^4.1.11",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.11",
    "yaml-eslint-parser": "^2.1.0"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  },
  "packageManager": "pnpm@10.28.0"
}
